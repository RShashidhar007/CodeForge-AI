# =============================================
# CodeForge AI Backend - Environment Variables
# =============================================
# Copy this file to .env and fill in the values

# =============================================
# Database Configuration
# =============================================
DB_PASSWORD=Admin@123456

# =============================================
# JWT Configuration
# =============================================
# MUST be at least 32 characters for HS256
JWT_SECRET=your-super-secret-key-change-this-to-at-least-32-characters-long-in-production
JWT_EXPIRATION_SECONDS=86400

# =============================================
# CORS Configuration
# =============================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# =============================================
# Admin User Bootstrap
# =============================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Platform Admin

# =============================================
# AI/LLM Configuration
# =============================================
# Provider: openai or mock
LLM_PROVIDER=mock
LLM_MODEL=gpt-4-turbo
LLM_API_KEY=sk-your-openai-key-here

# Provider: openai or mock
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=sk-your-openai-key-here

# =============================================
# Redis Configuration (Docker)
# =============================================
REDIS_HOST=redis
REDIS_PORT=6379

# =============================================
# Local Development (if running without Docker)
# =============================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# DB_PASSWORD=Admin@123456
