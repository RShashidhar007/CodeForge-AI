# Python FastAPI Backend Environment Variables
# Copy this file to .env and fill in with your configuration
# DO NOT COMMIT .env TO VERSION CONTROL

# ===== DATABASE =====
# MSSQL Connection (Docker)
DB_URL=mssql+pyodbc://sa:Admin@123456@localhost:1433/recruitment_platform?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

# Alternative: Local MSSQL Installation
# DB_URL=mssql+pyodbc://sa:your_password@localhost:1433/recruitment_platform?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

# ===== JWT AUTHENTICATION =====
JWT_SECRET=your-secret-key-must-be-at-least-32-characters-long-change-this
JWT_EXPIRATION_SECONDS=86400

# ===== CORS =====
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== ADMIN BOOTSTRAP =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Platform Admin

# ===== SERVER =====
PORT=8080

# ===== MONTH 2: AI & LLM CONFIGURATION =====

# LLM Provider Selection
# For demo: use 'mock' (no API key needed)
# Options: openai, mock
LLM_PROVIDER=mock

# LLM Model Configuration
# For OpenAI: gpt-4-turbo, gpt-4, gpt-3.5-turbo
LLM_MODEL=gpt-4-turbo

# LLM API Key
# Get from: https://platform.openai.com/api-keys
# For testing, use: sk-test-key (works with mock provider)
LLM_API_KEY=sk-your-openai-api-key-here

# LLM Parameters
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7

# ===== EMBEDDING CONFIGURATION =====

# Embedding Provider Selection
# For demo: use 'mock' (no API key needed)
# Options: openai, mock
EMBEDDING_PROVIDER=mock

# Embedding Model
# For OpenAI: text-embedding-3-small (1536 dims), text-embedding-3-large (3072 dims)
EMBEDDING_MODEL=text-embedding-3-small

# Embedding API Key
# Can be same as LLM_API_KEY if using OpenAI
EMBEDDING_API_KEY=sk-your-openai-api-key-here

# Embedding Dimension (must match model output)
# text-embedding-3-small: 1536
# text-embedding-3-large: 3072
EMBEDDING_DIMENSION=1536

# ===== REDIS CONFIGURATION =====
REDIS_URL=redis://localhost:6379

# ===== REPOSITORY INDEXING CONFIGURATION =====

# Maximum file size to process (MB)
MAX_FILE_SIZE_MB=10

# Supported file extensions (comma-separated)
SUPPORTED_EXTENSIONS=.py,.js,.ts,.tsx,.jsx,.java,.go,.rs,.cpp,.c,.cs,.html,.css,.sql,.json,.yaml,.yml,.md

# Paths to ignore during indexing (comma-separated)
IGNORED_PATHS=node_modules,.git,dist,build,__pycache__,.venv,target,.next,.pytest_cache,*.pyc,*.egg-info

# ===== FOR DEVELOPMENT/TESTING =====
# Demo setup with mock providers (no API keys needed)
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
LLM_API_KEY=sk-test-key
EMBEDDING_API_KEY=sk-test-key

# ===== NOTES =====
# 1. Never commit actual API keys to version control
# 2. For demo, mock providers are used (no API keys needed)
# 3. MSSQL runs in Docker with default credentials (sa/Admin@123456)
# 4. Vector search uses mock provider for demo (not semantic in MSSQL)
# 5. To enable real LLM/embeddings, set provider=openai and add API keys
